<p>
  Ефективна глибина:
  <output id="depth-value">5</output>
</p>

<canvas id="carpet-demo" width="540" height="540"></canvas>

<script>
  const canvasElement = document.getElementById("carpet-demo");
  if (!(canvasElement instanceof HTMLCanvasElement)) {
    throw new Error("Canvas не знайдено");
  }

  const canvas = canvasElement;

  const canvasContext = canvas.getContext("2d");
  if (!canvasContext) {
    throw new Error("Не вдалося отримати 2D-контекст");
  }

  const context = canvasContext;

  const depthValueElement = document.getElementById("depth-value");
  if (!(depthValueElement instanceof HTMLOutputElement)) {
    throw new Error("Output не знайдено");
  }

  const depthValue = depthValueElement;

  const BASE_DEPTH = 5;
  const MAX_DEPTH = 24;

  function getEffectiveDepth(scale: number) {
    const additionalLevels = Math.floor(Math.log(scale) / Math.log(3));

    return Math.min(MAX_DEPTH, BASE_DEPTH + additionalLevels);
  }

  type Camera = {
    centerX: number;
    centerY: number;
    scale: number;
  };

  const camera: Camera = {
    centerX: 0.5,
    centerY: 0.5,
    scale: 1,
  };

  function worldToScreenX(
    worldX: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    return (
      (worldX - camera.centerX) * canvas.width * camera.scale + canvas.width / 2
    );
  }

  function worldToScreenY(
    worldY: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    return (
      (worldY - camera.centerY) * canvas.height * camera.scale +
      canvas.height / 2
    );
  }

  function worldToScreenWidth(
    worldSize: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    return worldSize * canvas.width * camera.scale;
  }

  function worldToScreenHeight(
    worldSize: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    return worldSize * canvas.height * camera.scale;
  }

  function screenToWorldX(
    screenX: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    return (
      (screenX - canvas.width / 2) / (canvas.width * camera.scale) +
      camera.centerX
    );
  }

  function screenToWorldY(
    screenY: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    return (
      (screenY - canvas.height / 2) / (canvas.height * camera.scale) +
      camera.centerY
    );
  }

  function render(
    canvas: HTMLCanvasElement,
    context: CanvasRenderingContext2D,
    depthValue: HTMLOutputElement,
  ) {
    context.clearRect(0, 0, canvas.width, canvas.height);

    const effectiveDepth = getEffectiveDepth(camera.scale);
    const carpetX = worldToScreenX(0, canvas, camera);
    const carpetY = worldToScreenY(0, canvas, camera);
    const carpetWidth = worldToScreenWidth(1, canvas, camera);
    const carpetHeight = worldToScreenHeight(1, canvas, camera);

    context.fillStyle = "rgb(0 0 100)";
    context.fillRect(carpetX, carpetY, carpetWidth, carpetHeight);

    drawCarpet(context, 0, 0, 1, effectiveDepth, canvas, camera);

    depthValue.value = String(effectiveDepth);
  }

  function drawCenterCutout(
    context: CanvasRenderingContext2D,
    x: number,
    y: number,
    size: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    const partSize = size / 3;
    const centerX = x + partSize;
    const centerY = y + partSize;

    const screenX = worldToScreenX(centerX, canvas, camera);
    const screenY = worldToScreenY(centerY, canvas, camera);
    const screenWidth = worldToScreenWidth(partSize, canvas, camera);
    const screenHeight = worldToScreenHeight(partSize, canvas, camera);

    context.fillStyle = "rgb(0 100 0)";
    context.fillRect(screenX, screenY, screenWidth, screenHeight);
  }

  function drawCarpet(
    context: CanvasRenderingContext2D,
    x: number,
    y: number,
    size: number,
    depth: number,
    canvas: HTMLCanvasElement,
    camera: Camera,
  ) {
    const screenX = worldToScreenX(x, canvas, camera);
    const screenY = worldToScreenY(y, canvas, camera);
    const screenWidth = worldToScreenWidth(size, canvas, camera);
    const screenHeight = worldToScreenHeight(size, canvas, camera);

    const isOutsideCanvas =
      screenX + screenWidth <= 0 ||
      screenY + screenHeight <= 0 ||
      screenX >= canvas.width ||
      screenY >= canvas.height;

    if (isOutsideCanvas) {
      return;
    }

    const cutoutWidth = screenWidth / 3;
    const cutoutHeight = screenHeight / 3;
    const isCutoutTooSmall = cutoutWidth < 1 || cutoutHeight < 1;

    if (isCutoutTooSmall) {
      return;
    }

    drawCenterCutout(context, x, y, size, canvas, camera);

    if (depth <= 1) {
      return;
    }

    const partSize = size / 3;

    for (let row = 0; row < 3; row++) {
      for (let column = 0; column < 3; column++) {
        if (row === 1 && column === 1) {
          continue;
        }

        const childX = x + column * partSize;
        const childY = y + row * partSize;

        drawCarpet(
          context,
          childX,
          childY,
          partSize,
          depth - 1,
          canvas,
          camera,
        );
      }
    }
  }

  let animationFrameId: number | null = null;

  function scheduleRender() {
    if (animationFrameId !== null) {
      return;
    }

    animationFrameId = requestAnimationFrame(() => {
      animationFrameId = null;
      render(canvas, context, depthValue);
    });
  }
  canvas.addEventListener(
    "wheel",
    (event) => {
      event.preventDefault();

      const rect = canvas.getBoundingClientRect();
      const screenX = (event.clientX - rect.left) * (canvas.width / rect.width);
      const screenY =
        (event.clientY - rect.top) * (canvas.height / rect.height);

      const worldXBeforeZoom = screenToWorldX(screenX, canvas, camera);
      const worldYBeforeZoom = screenToWorldY(screenY, canvas, camera);

      const zoomFactor = 1.1;

      if (event.deltaY < 0) {
        camera.scale *= zoomFactor;
      } else {
        camera.scale /= zoomFactor;
      }

      camera.scale = Math.max(1, Math.min(camera.scale, 10));

      const worldXAfterZoom = screenToWorldX(screenX, canvas, camera);
      const worldYAfterZoom = screenToWorldY(screenY, canvas, camera);

      camera.centerX += worldXBeforeZoom - worldXAfterZoom;
      camera.centerY += worldYBeforeZoom - worldYAfterZoom;

      scheduleRender();
    },
    { passive: false },
  );

  render(canvas, context, depthValue);
</script>
