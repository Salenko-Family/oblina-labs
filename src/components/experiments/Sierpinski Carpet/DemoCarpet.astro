<section class="playground">
  <header class="header">
    <p class="label">Інтерактивний приклад</p>

    <h2 class="title">Килим Серпінського</h2>

    <p class="description">
      Наближайте фрактал коліщатком миші або жестом двома пальцями. Деталізація
      автоматично збільшується разом із масштабом.
    </p>
  </header>

  <div class="canvas-panel">
    <canvas
      id="carpet-demo"
      width="540"
      height="540"
      aria-label="Інтерактивний Килим Серпінського"
    >
      Ваш браузер не підтримує Canvas.
    </canvas>
  </div>

  <div class="controls">
    <p class="depth-status">
      Ефективна глибина:
      <output id="depth-value">5</output>
      <span aria-hidden="true">/ 24</span>
    </p>

    <button id="reset-view" class="button secondary-button" type="button">
      Скинути вигляд
    </button>
  </div>

  <p class="hint">Колесо миші або жест двома пальцями — масштабування.</p>
</section>

<script>
  const canvasElement = document.getElementById("carpet-demo");
  if (!(canvasElement instanceof HTMLCanvasElement)) {
    throw new Error("Canvas не знайдено");
  }

  const canvas = canvasElement;

  const canvasContext = canvas.getContext("2d");
  if (!canvasContext) {
    throw new Error("Не вдалося отримати 2D-контекст");
  }

  const context = canvasContext;

  const depthValueElement = document.getElementById("depth-value");
  if (!(depthValueElement instanceof HTMLOutputElement)) {
    throw new Error("Output не знайдено");
  }

  const depthValue = depthValueElement;

  const resetElement = document.getElementById("reset-view");
  if (!(resetElement instanceof HTMLButtonElement)) {
    throw new Error("Кнопку скидання не знайдено");
  }

  const resetButton = resetElement;

  const BASE_DEPTH = 5;
  const MAX_DEPTH = 24;
  const MIN_SCALE = 1;
  const MAX_SCALE = 3 ** (MAX_DEPTH - BASE_DEPTH);

  const CARPET_COLOR = "#264653";
  const CUTOUT_COLOR = "#dff58a";

  function getEffectiveDepth(scale: number) {
    const additionalLevels = Math.floor(Math.log(scale) / Math.log(3));

    return Math.min(MAX_DEPTH, BASE_DEPTH + additionalLevels);
  }

  type Camera = {
    centerX: number;
    centerY: number;
    scale: number;
  };

  const camera: Camera = {
    centerX: 0.5,
    centerY: 0.5,
    scale: 1,
  };

  type Point = {
    x: number;
    y: number;
  };

  function resetCamera() {
    camera.centerX = 0.5;
    camera.centerY = 0.5;
    camera.scale = MIN_SCALE;
  }

  function worldToScreenX(worldX: number) {
    return (
      (worldX - camera.centerX) * canvas.width * camera.scale + canvas.width / 2
    );
  }

  function worldToScreenY(worldY: number) {
    return (
      (worldY - camera.centerY) * canvas.height * camera.scale +
      canvas.height / 2
    );
  }

  function worldToScreenWidth(worldSize: number) {
    return worldSize * canvas.width * camera.scale;
  }

  function worldToScreenHeight(worldSize: number) {
    return worldSize * canvas.height * camera.scale;
  }

  function screenToWorldX(screenX: number) {
    return (
      (screenX - canvas.width / 2) / (canvas.width * camera.scale) +
      camera.centerX
    );
  }

  function screenToWorldY(screenY: number) {
    return (
      (screenY - canvas.height / 2) / (canvas.height * camera.scale) +
      camera.centerY
    );
  }

  function clientToCanvas(clientX: number, clientY: number): Point {
    const rect = canvas.getBoundingClientRect();

    return {
      x: (clientX - rect.left) * (canvas.width / rect.width),
      y: (clientY - rect.top) * (canvas.height / rect.height),
    };
  }

  function constrainCamera() {
    const halfVisibleWorldSize = 1 / (2 * camera.scale);

    const minCenter = halfVisibleWorldSize;
    const maxCenter = 1 - halfVisibleWorldSize;

    camera.centerX = Math.max(minCenter, Math.min(camera.centerX, maxCenter));

    camera.centerY = Math.max(minCenter, Math.min(camera.centerY, maxCenter));
  }

  function zoomAt(screenX: number, screenY: number, multiplier: number) {
    const worldXBeforeZoom = screenToWorldX(screenX);
    const worldYBeforeZoom = screenToWorldY(screenY);

    camera.scale *= multiplier;

    camera.scale = Math.max(MIN_SCALE, Math.min(camera.scale, MAX_SCALE));

    const worldXAfterZoom = screenToWorldX(screenX);
    const worldYAfterZoom = screenToWorldY(screenY);

    camera.centerX += worldXBeforeZoom - worldXAfterZoom;

    camera.centerY += worldYBeforeZoom - worldYAfterZoom;

    constrainCamera();
    scheduleRender();
  }

  function render() {
    context.clearRect(0, 0, canvas.width, canvas.height);

    const effectiveDepth = getEffectiveDepth(camera.scale);
    const carpetX = worldToScreenX(0);
    const carpetY = worldToScreenY(0);
    const carpetWidth = worldToScreenWidth(1);
    const carpetHeight = worldToScreenHeight(1);

    context.fillStyle = CARPET_COLOR;
    context.fillRect(carpetX, carpetY, carpetWidth, carpetHeight);

    drawCarpet(0, 0, 1, effectiveDepth);

    depthValue.value = String(effectiveDepth);
  }

  function drawCenterCutout(x: number, y: number, size: number) {
    const partSize = size / 3;
    const centerX = x + partSize;
    const centerY = y + partSize;

    const screenX = worldToScreenX(centerX);
    const screenY = worldToScreenY(centerY);
    const screenWidth = worldToScreenWidth(partSize);
    const screenHeight = worldToScreenHeight(partSize);

    context.fillStyle = CUTOUT_COLOR;
    context.fillRect(screenX, screenY, screenWidth, screenHeight);
  }

  function drawCarpet(x: number, y: number, size: number, depth: number) {
    const screenX = worldToScreenX(x);
    const screenY = worldToScreenY(y);
    const screenWidth = worldToScreenWidth(size);
    const screenHeight = worldToScreenHeight(size);

    const isOutsideCanvas =
      screenX + screenWidth <= 0 ||
      screenY + screenHeight <= 0 ||
      screenX >= canvas.width ||
      screenY >= canvas.height;

    if (isOutsideCanvas) {
      return;
    }

    const cutoutWidth = screenWidth / 3;
    const cutoutHeight = screenHeight / 3;
    const isCutoutTooSmall = cutoutWidth < 1 || cutoutHeight < 1;

    if (isCutoutTooSmall) {
      return;
    }

    drawCenterCutout(x, y, size);

    if (depth <= 1) {
      return;
    }

    const partSize = size / 3;

    for (let row = 0; row < 3; row++) {
      for (let column = 0; column < 3; column++) {
        if (row === 1 && column === 1) {
          continue;
        }

        const childX = x + column * partSize;
        const childY = y + row * partSize;

        drawCarpet(childX, childY, partSize, depth - 1);
      }
    }
  }

  let animationFrameId: number | null = null;

  function scheduleRender() {
    if (animationFrameId !== null) {
      return;
    }

    animationFrameId = requestAnimationFrame(() => {
      animationFrameId = null;
      render();
    });
  }

  canvas.addEventListener(
    "wheel",
    (event) => {
      event.preventDefault();

      const point = clientToCanvas(event.clientX, event.clientY);

      const zoomFactor = 1.1;

      const multiplier = event.deltaY < 0 ? zoomFactor : 1 / zoomFactor;

      zoomAt(point.x, point.y, multiplier);
    },
    { passive: false },
  );

  const activePointers = new Map<number, Point>();

  let previousPinchDistance: number | null = null;
  function getDistance(first: Point, second: Point) {
    return Math.hypot(second.x - first.x, second.y - first.y);
  }

  function getMiddlePoint(first: Point, second: Point): Point {
    return {
      x: (first.x + second.x) / 2,
      y: (first.y + second.y) / 2,
    };
  }

  canvas.addEventListener("pointerdown", (event) => {
    if (event.pointerType !== "touch") {
      return;
    }

    canvas.setPointerCapture(event.pointerId);
    const point = clientToCanvas(event.clientX, event.clientY);
    activePointers.set(event.pointerId, point);

    if (activePointers.size === 2) {
      const [first, second] = [...activePointers.values()];

      previousPinchDistance = getDistance(first, second);
    } else {
      previousPinchDistance = null;
    }
  });

  canvas.addEventListener("pointermove", (event) => {
    if (event.pointerType !== "touch" || !activePointers.has(event.pointerId)) {
      return;
    }

    const point = clientToCanvas(event.clientX, event.clientY);
    activePointers.set(event.pointerId, point);

    if (activePointers.size !== 2) {
      return;
    }

    const [first, second] = [...activePointers.values()];
    const currentDistance = getDistance(first, second);
    const middlePoint = getMiddlePoint(first, second);

    if (previousPinchDistance !== null && previousPinchDistance > 0) {
      const multiplier = currentDistance / previousPinchDistance;

      zoomAt(middlePoint.x, middlePoint.y, multiplier);
    }

    previousPinchDistance = currentDistance;
  });

  function removePointer(event: PointerEvent) {
    activePointers.delete(event.pointerId);
    previousPinchDistance = null;
  }

  canvas.addEventListener("pointerup", removePointer);
  canvas.addEventListener("pointercancel", removePointer);

  resetButton.addEventListener("click", () => {
    resetCamera();
    scheduleRender();
  });

  render();
</script>
<style>
  .playground {
    display: flex;
    flex-direction: column;
    gap: 24px;

    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(16px, 5vw, 32px);
    box-sizing: border-box;

    background-color: #fffdf5;
    border: 2px solid #171717;
    border-radius: 24px;
    box-shadow: 8px 8px 0 #171717;
  }

  .header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .label {
    width: fit-content;
    margin: 0;
    padding: 6px 10px;

    background-color: #d9ff66;
    border: 1px solid #171717;
    border-radius: 999px;

    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .title {
    margin: 0;
    font-size: clamp(28px, 5vw, 42px);
    line-height: 1.1;
  }

  .description {
    max-width: 760px;
    margin: 0;

    color: #555;
    font-size: 16px;
    line-height: 1.5;
  }

  .canvas-panel {
    display: flex;
    align-items: center;
    justify-content: center;

    min-height: 588px;
    padding: clamp(12px, 4vw, 24px);
    box-sizing: border-box;

    overflow: hidden;
    background-color: #f4f0e5;
    border: 2px solid #171717;
    border-radius: 18px;
  }

  #carpet-demo {
    display: block;
    width: min(100%, 540px);
    height: auto;
    aspect-ratio: 1;

    background-color: #fffdf5;
    border: 2px solid #171717;
    border-radius: 14px;

    touch-action: none;
    user-select: none;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .depth-status {
    width: fit-content;
    margin: 0;
    padding: 10px 14px;

    background-color: #d9ff66;
    border: 1px solid #171717;
    border-radius: 999px;

    font-size: 14px;
    font-weight: 700;
  }

  #depth-value {
    font-variant-numeric: tabular-nums;
  }

  .button {
    min-height: 49px;
    padding: 0 24px;

    border: 2px solid #171717;
    border-radius: 10px;
    box-shadow: 3px 3px 0 #171717;

    font: inherit;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .secondary-button {
    background-color: #fffdf5;
  }

  .button:active {
    translate: 2px 2px;
    box-shadow: 1px 1px 0 #171717;
  }

  .button:focus-visible {
    outline: 3px solid #d9ff66;
    outline-offset: 3px;
  }

  .hint {
    margin: -8px 0 0;

    color: #666;
    font-size: 14px;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .playground {
      gap: 20px;
      box-shadow: 5px 5px 0 #171717;
    }

    .canvas-panel {
      min-height: auto;
      padding: 10px;
    }

    .controls {
      align-items: stretch;
      flex-direction: column;
    }

    .depth-status {
      box-sizing: border-box;
      text-align: center;
    }

    .button {
      width: 100%;
    }

    .hint {
      margin-top: -4px;
      text-align: center;
    }
  }
</style>
