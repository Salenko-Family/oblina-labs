---
interface Props {
  title: string;
  description: string;
  status: string;
  href?: string;
}

const { title, description, status, href } = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag href={href} class="experiment-card">
  <div>
    <p class="experiment-label">Experiment</p>
    <h3>{title}</h3>
    <p class="experiment-description">{description}</p>
  </div>

  <p class="experiment-status">{status}</p>
</Tag>
<style>
  .experiment-card {
    padding: 32px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    border-top: 2px solid var(--color-text);
  }

  .experiment-label {
    margin: 0 0 24px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .experiment-description {
    max-width: 680px;
    margin: 16px 0 0;
    font-size: 17px;
  }

  .experiment-status {
    flex-shrink: 0;
    margin: 0;
    padding: 7px 14px;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .experiment-card {
      padding: 28px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }
  }
</style>
