---
interface Props {
  title: string;
  description: string;
  href?: string;
  publishedAt?: string;
  preview?: {
    image: string;
    video: string;
  };
}

const { title, description, href, publishedAt, preview } = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag href={href} class="experiment-card">
  <div class="experiment-content">
    <p class="experiment-label">Experiment</p>

    <h3>{title}</h3>

    <p class="experiment-description">{description}</p>

    {
      publishedAt && (
        <time class="experiment-date" datetime={publishedAt}>
          {publishedAt}
        </time>
      )
    }
  </div>

  {
    preview && (
      <div class="experiment-preview">
        <img
          class="experiment-preview-image"
          src={preview.image}
          alt={`Превʼю експерименту «${title}»`}
          loading="lazy"
        />

        <video
          class="experiment-preview-video"
          src={preview.video}
          muted
          playsinline
          preload="metadata"
        />
      </div>
    )
  }
</Tag>

<script>
  const cards = document.querySelectorAll(".experiment-card");

  const visibleCards = new Set<Element>();

  let currentIndex = 0;
  let hoveredCard: Element | null = null;

  const getVisibleCards = () => {
    const result: Element[] = [];

    cards.forEach((card) => {
      if (visibleCards.has(card)) {
        result.push(card);
      }
    });

    return result;
  };

  const getVideo = (card: Element) => {
    return card.querySelector(".experiment-preview-video");
  };

  const stopCard = (card: Element) => {
    const video = getVideo(card);

    if (video instanceof HTMLVideoElement) {
      video.pause();
      video.currentTime = 0;
    }

    card.classList.remove("is-playing");
  };

  const playCard = (card: Element) => {
    const video = getVideo(card);

    if (video instanceof HTMLVideoElement) {
      card.classList.add("is-playing");
      video.play();
    }
  };

  const stopAllCards = () => {
    cards.forEach((card) => {
      stopCard(card);
    });
  };

  const playCurrentCard = () => {
    if (hoveredCard) {
      return;
    }

    const visibleList = getVisibleCards();

    if (visibleList.length === 0) {
      stopAllCards();
      currentIndex = 0;
      return;
    }

    if (currentIndex >= visibleList.length) {
      currentIndex = 0;
    }

    const currentCard = visibleList[currentIndex];

    stopAllCards();
    playCard(currentCard);
  };

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          visibleCards.add(entry.target);
        } else {
          visibleCards.delete(entry.target);
        }
      });

      if (hoveredCard && !visibleCards.has(hoveredCard)) {
        hoveredCard = null;
      }

      if (!hoveredCard) {
        playCurrentCard();
      }
    },
    {
      threshold: 0.35,
    },
  );

  cards.forEach((card) => {
    observer.observe(card);

    const video = getVideo(card);

    if (!(video instanceof HTMLVideoElement)) {
      return;
    }

    video.addEventListener("ended", () => {
      if (hoveredCard === card) {
        video.currentTime = 0;
        video.play();
        return;
      }

      if (hoveredCard) {
        return;
      }

      currentIndex += 1;
      playCurrentCard();
    });

    card.addEventListener("mouseenter", () => {
      hoveredCard = card;

      stopAllCards();
      playCard(card);
    });

    card.addEventListener("mouseleave", () => {
      hoveredCard = null;

      stopCard(card);

      currentIndex = 0;
      playCurrentCard();
    });
  });
</script>

<style>
  .experiment-card {
    padding: 32px;

    display: flex;
    align-items: flex-end;
    gap: 40px;

    color: inherit;
    text-decoration: none;

    border-top: 2px solid var(--color-text);
  }

  .experiment-content {
    flex: 1;
    min-width: 0;
  }

  .experiment-label {
    margin: 0 0 24px;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;

    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .experiment-description {
    max-width: 680px;
    margin: 16px 0 0;

    font-size: 17px;
  }

  .experiment-date {
    display: block;
    margin-top: 16px;

    color: var(--color-muted, #666);

    font-size: 14px;
    line-height: 1.5;
  }

  .experiment-preview {
    position: relative;

    width: 220px;
    aspect-ratio: 1;
    flex-shrink: 0;

    overflow: hidden;

    border: 2px solid var(--color-text);
    border-radius: 16px;
  }

  .experiment-preview-image,
  .experiment-preview-video {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;
    object-fit: cover;
  }

  .experiment-preview-video {
    opacity: 0;
  }

  .experiment-card.is-playing .experiment-preview-image {
    opacity: 0;
  }

  .experiment-card.is-playing .experiment-preview-video {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .experiment-card {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .experiment-preview {
      width: 180px;
    }
  }

  @media (max-width: 600px) {
    .experiment-card {
      padding: 28px 0;

      flex-direction: column;
      gap: 24px;
    }

    .experiment-preview {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
