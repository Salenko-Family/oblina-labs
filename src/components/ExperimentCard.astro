---
interface Props {
  title: string;
  description: string;
  href?: string;
  publishedAt?: string;
  preview?: {
    image: string;
    video: string;
  };
}

const { title, description, href, publishedAt, preview } = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag href={href} class="experiment-card">
  <div class="experiment-content">
    <p class="experiment-label">Experiment</p>

    <h3>{title}</h3>

    <p class="experiment-description">{description}</p>

    {
      publishedAt && (
        <time class="experiment-date" datetime={publishedAt}>
          {publishedAt}
        </time>
      )
    }
  </div>

  {
    preview && (
      <div class="experiment-preview">
        <img
          class="experiment-preview-image"
          src={preview.image}
          alt={`Превʼю експерименту «${title}»`}
          loading="lazy"
        />

        <video
          class="experiment-preview-video"
          src={preview.video}
          muted
          loop
          playsinline
          preload="metadata"
        />
      </div>
    )
  }
</Tag>

<script>
  const cards = document.querySelectorAll(".experiment-card");

  function stopAllPreviews() {
    cards.forEach((card) => {
      card.classList.remove("is-playing");

      const video = card.querySelector(".experiment-preview-video");

      if (video instanceof HTMLVideoElement) {
        video.pause();
        video.currentTime = 0;
      }
    });
  }

  cards.forEach((card) => {
    const video = card.querySelector(".experiment-preview-video");

    if (!(video instanceof HTMLVideoElement)) {
      return;
    }

    card.addEventListener("mouseenter", () => {
      stopAllPreviews();

      card.classList.add("is-playing");
      video.play();
    });

    card.addEventListener("mouseleave", () => {
      card.classList.remove("is-playing");

      video.pause();
      video.currentTime = 0;
    });
  });
</script>

<style>
  .experiment-card {
    padding: 32px;

    display: flex;
    align-items: flex-end;
    gap: 40px;

    color: inherit;
    text-decoration: none;

    border-top: 2px solid var(--color-text);
  }

  .experiment-content {
    flex: 1;
    min-width: 0;
  }

  .experiment-label {
    margin: 0 0 24px;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;

    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .experiment-description {
    max-width: 680px;
    margin: 16px 0 0;

    font-size: 17px;
  }

  .experiment-date {
    display: block;
    margin-top: 16px;

    color: var(--color-muted, #666);

    font-size: 14px;
    line-height: 1.5;
  }

  .experiment-preview {
    position: relative;

    width: 220px;
    aspect-ratio: 1;
    flex-shrink: 0;

    overflow: hidden;

    border: 2px solid var(--color-text);
    border-radius: 16px;
  }

  .experiment-preview-image,
  .experiment-preview-video {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    display: block;
    object-fit: cover;
  }

  .experiment-preview-video {
    opacity: 0;
  }

  .experiment-card.is-playing .experiment-preview-image {
    opacity: 0;
  }

  .experiment-card.is-playing .experiment-preview-video {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .experiment-card {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .experiment-preview {
      width: 180px;
    }
  }

  @media (max-width: 600px) {
    .experiment-card {
      padding: 28px 0;

      flex-direction: column;
      gap: 24px;
    }

    .experiment-preview {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
