---
interface Props {
  title: string;
  description: string;
  status: string;
  href?: string;
  publishedAt?: string;
  preview?: {
    image: string;
    video: string;
  };
}

const { title, description, status, href, publishedAt, preview } = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag href={href} class="experiment-card">
  <div class="experiment-content">
    <p class="experiment-label">Experiment</p>

    <h3>{title}</h3>

    <p class="experiment-description">{description}</p>

    {
      publishedAt && (
        <time class="experiment-date" datetime={publishedAt}>
          {publishedAt}
        </time>
      )
    }
  </div>

  {
    preview && (
      <div class="experiment-preview">
        <img
          src={preview.image}
          alt={`Превʼю експерименту «${title}»`}
          loading="lazy"
        />
      </div>
    )
  }

  <!-- <p class="experiment-status">{status}</p> -->
</Tag>

<style>
  .experiment-card {
    padding: 32px;

    display: flex;
    align-items: flex-end;
    gap: 40px;

    color: inherit;
    text-decoration: none;

    border-top: 2px solid var(--color-text);
  }

  .experiment-content {
    flex: 1;
    min-width: 0;
  }

  .experiment-label {
    margin: 0 0 24px;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;

    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .experiment-description {
    max-width: 680px;
    margin: 16px 0 0;

    font-size: 17px;
  }

  .experiment-date {
    display: block;
    margin-top: 16px;

    color: var(--color-muted, #666);

    font-size: 14px;
    line-height: 1.5;
  }

  .experiment-preview {
    width: 220px;
    aspect-ratio: 1;
    flex-shrink: 0;

    overflow: hidden;

    border: 2px solid var(--color-text);
    border-radius: 16px;
  }

  .experiment-preview img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
  }

  .experiment-status {
    flex-shrink: 0;

    margin: 0;
    padding: 7px 14px;

    border: 1px solid currentColor;
    border-radius: 999px;

    font-size: 13px;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .experiment-card {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .experiment-preview {
      width: 180px;
    }
  }

  @media (max-width: 600px) {
    .experiment-card {
      padding: 28px 0;

      flex-direction: column;
      gap: 24px;
    }

    .experiment-preview {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
