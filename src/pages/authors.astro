---
import BaseLayout from "../layouts/BaseLayout.astro";
import { authorList } from "../data/authors";
import { articles } from "../data/articles";
import { experiments } from "../data/experiments";
import { projects } from "../data/projects";
---

<BaseLayout title="Автори — Oblina Labs">
  <main class="authors-page">
    <header class="authors-header">
      <p class="authors-label">OBLINA LABS</p>

      <h1>Автори</h1>

      <p class="authors-lead">
        Люди, які створюють проєкти, експерименти та навчальні матеріали Oblina
        Labs.
      </p>
    </header>

    <section class="authors-list">
      {
        authorList.map((author) => {
          const authorExperiments = experiments.filter((experiment) =>
            experiment.authors.includes(author.id),
          );

          const authorProjects = projects.filter((project) =>
            project.authors.includes(author.id),
          );

          const authorArticles = articles.filter(
            (article) => article.authorId === author.id,
          );

          return (
            <article class="author" id={author.id}>
              <div class="author-photo">
                {author.image ? (
                  <img src={author.image} alt={author.name} />
                ) : (
                  <span>{author.name.charAt(0)}</span>
                )}
              </div>

              <div class="author-content">
                <p class="author-role">{author.role}</p>

                <h2>{author.name}</h2>

                <p class="author-bio">{author.bio}</p>

                {(author.links.github || author.links.linkedin) && (
                  <div class="author-links">
                    {author.links.github && (
                      <a
                        href={author.links.github}
                        target="_blank"
                        rel="noreferrer"
                      >
                        GitHub ↗
                      </a>
                    )}

                    {author.links.linkedin && (
                      <a
                        href={author.links.linkedin}
                        target="_blank"
                        rel="noreferrer"
                      >
                        LinkedIn ↗
                      </a>
                    )}
                  </div>
                )}

                {authorProjects.length > 0 && (
                  <div class="author-materials">
                    <p class="author-materials-title">Проєкти</p>

                    <ul>
                      {authorProjects.map((project) => (
                        <li>
                          <a href={`/projects/${project.slug}`}>
                            {project.title}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {authorExperiments.length > 0 && (
                  <div class="author-materials">
                    <p class="author-materials-title">Експерименти</p>

                    <ul>
                      {authorExperiments.map((experiment) => (
                        <li>
                          <a href={experiment.href}>
                            {experiment.title}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {authorArticles.length > 0 && (
                  <div class="author-materials">
                    <p class="author-materials-title">Статті</p>

                    <ul>
                      {authorArticles.map((article) => (
                        <li>
                          <a href={`/articles/${article.slug}`}>
                            {article.title}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          );
        })
      }
    </section>
  </main>
</BaseLayout>

<style>
  .authors-page {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
    padding: 80px 0 120px;
  }

  .authors-header {
    max-width: 800px;
    margin-bottom: 72px;
  }

  .authors-label {
    margin: 0 0 16px;

    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .authors-header h1 {
    margin: 0;

    font-size: clamp(56px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .authors-lead {
    max-width: 650px;
    margin: 32px 0 0;

    font-size: 20px;
    line-height: 1.5;
  }

  .authors-list {
    display: grid;
    gap: 32px;
  }

  .author {
    min-height: 420px;
    padding: 48px;

    display: grid;
    grid-template-columns: minmax(220px, 320px) 1fr;
    gap: 56px;

    border: 2px solid var(--color-text);
    border-radius: 24px;

    scroll-margin-top: 40px;
  }

  .author:nth-child(1) {
    background: var(--color-lime);
    color: var(--color-text);
  }

  .author:nth-child(2) {
    background: var(--color-accent);
    color: white;
  }

  .author-photo {
    width: 100%;
    aspect-ratio: 1;

    overflow: hidden;

    display: grid;
    place-items: center;

    border: 2px solid currentColor;
    border-radius: 20px;
  }

  .author-photo img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .author-photo span {
    font-size: 96px;
    font-weight: 700;
  }

  .author-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .author-role {
    margin: 0 0 20px;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .author h2 {
    margin: 0;

    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .author-bio {
    max-width: 600px;
    margin: 28px 0 0;

    font-size: 18px;
    line-height: 1.55;
  }

  .author-links {
    display: flex;
    gap: 24px;

    margin-top: 40px;
  }

  .author-links a {
    color: inherit;

    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .author-links a:hover {
    text-decoration-thickness: 2px;
  }

  .author-materials {
    margin-top: 48px;
    padding-top: 28px;

    border-top: 1px solid currentColor;
  }

  .author-materials-title {
    margin: 0 0 16px;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .author-materials ul {
    margin: 0;
    padding: 0;

    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;

    list-style: none;
  }

  .author-materials a {
    color: inherit;

    font-size: 16px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .author-materials a:hover {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 760px) {
    .authors-page {
      width: min(100% - 32px, 1200px);
      padding: 48px 0 80px;
    }

    .authors-header {
      margin-bottom: 48px;
    }

    .authors-lead {
      font-size: 18px;
    }

    .author {
      min-height: 0;
      padding: 24px;

      grid-template-columns: 1fr;
      gap: 32px;
    }

    .author-photo {
      max-width: 280px;
    }
  }
</style>
