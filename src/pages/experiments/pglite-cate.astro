  }

  .data-preview-table th {
    background-color: #d9ff66;
    font-weight: 700;
  }

  .data-preview-table th:last-child,
  .data-preview-table td:last-child {
    border-right: 0;
  }

  .data-preview-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .playground-intro {
    margin-bottom: 32px !important;
  }

  .playground-intro > p {
    max-width: 760px;
  }

  code {
