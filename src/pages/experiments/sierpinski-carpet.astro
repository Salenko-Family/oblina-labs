    }

    h1 {
      margin: 0;

      font-size: clamp(2.75rem, 8vw, 5.5rem);
      line-height: 0.95;
      letter-spacing: -0.05em;
    }

    .article-lead {
      max-width: 680px;
      margin: 24px 0 0;

      font-size: clamp(1.25rem, 3vw, 1.75rem);
