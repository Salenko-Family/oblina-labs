---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ExperimentCard from "../components/ExperimentCard.astro";
import { experiments } from "../data/experiments";
import { projects } from "../data/projects";
---

<BaseLayout title="Oblina Labs">
  <main>
    <section id="hero">
      <p class="hero-label">Independent R&D lab</p>
      <h1>Ми створюємо, тестуємо та ділимося ідеями</h1>
      <p class="hero-description">
        Місце, де ідеї перетворюються на продукти, експерименти та навчальні
        матеріали.
      </p>
      <a class="hero-link" href="#projects">Дивитися проєкти</a>
    </section>
    <section id="projects">
      <h2>Рекомендовані проєкти</h2>
      <div class="project-grid">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              type={project.type}
              href={`/projects/${project.slug}`}
              image={project.image}
              color={project.color}
            />
          ))
        }
      </div>
    </section>
    <section id="experiments">
      <h2>Експерименти</h2>
      <div>
        {
          experiments.map((experiment) => (
            <ExperimentCard
              title={experiment.title}
              description={experiment.description}
              publishedAt={experiment.publishedAt}
              href={experiment.href}
              preview={experiment.preview}
            />
          ))
        }
      </div>
    </section>
    <section id="articles">
      <h2>Статті</h2>
      <div class="article-grid">
        <a href="/articles/how-i-became-a-developer" class="article-card">
          <p class="article-label">Особисте</p>
          <h3>Як я взагалі стала розробницею</h3>
          <p class="article-description">
            Від перших курсів до власних проєктів, Misolla та Oblina Labs.
          </p>
          <time class="article-date" datetime="2026-09-23">
            23 вересня 2026
          </time>
        </a>
      </div>
    </section>
    <section id="about">
      <p class="about-label">Про Oblina Labs</p>

      <h2>
        Простір, де ідеї перетворюються на експерименти, навчальні матеріали та
        справжні продукти.
      </h2>

      <div class="about-content">
        <p>
          Oblina Labs — незалежна лабораторія для власних розробок, досліджень і
          творчих технічних проєктів.
        </p>

        <p>
          Тут можна не лише побачити готовий результат, а й простежити шлях від
          початкової гіпотези до прототипу або завершеного продукту.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  main {
    width: min(1200px, calc(100% - 48px));
    margin: 0 auto;
  }
  #projects,
  #experiments,
  #articles,
  #about {
    margin-bottom: 120px;
  }

  #projects > h2,
  #experiments > h2,
  #articles > h2 {
    margin: 0 0 40px;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  #hero {
    margin-top: 40px;
    margin-bottom: 96px;
    padding: clamp(40px, 7vw, 96px);
    background: var(--color-lime);
    border: 2px solid var(--color-text);
    border-radius: 24px;
  }
  .hero-label {
    margin: 0 0 24px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  #hero h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .hero-description {
    max-width: 680px;
    margin: 32px 0;
    font-size: 20px;
  }
  .hero-link {
    display: inline-block;
    padding: 14px 22px;
    background: var(--color-text);
    color: var(--color-background);
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .article-card {
    padding: 32px;
    display: block;
    color: inherit;
    text-decoration: none;
    border-top: 2px solid var(--color-text);
  }

  .article-label {
    margin: 0 0 24px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .article-card h3 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .article-description {
    max-width: 680px;
    margin: 16px 0 0;
    font-size: 17px;
    line-height: 1.5;
  }

  .article-date {
    display: block;
    margin-top: 16px;
    color: var(--color-muted, #666);
    font-size: 14px;
    line-height: 1.5;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  #about {
    padding: clamp(40px, 7vw, 80px);
    background: var(--color-accent);
    color: var(--color-background);
    border: 2px solid var(--color-text);
    border-radius: 24px;
  }

  .about-label {
    margin: 0 0 32px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #about h2 {
    max-width: 950px;
    margin: 0 0 64px;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .about-content {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  .about-content p {
    margin: 0;
    font-size: 18px;
  }
  @media (max-width: 800px) {
    main {
      width: calc(100% - 32px);
    }
    .articles-grid {
      grid-template-columns: 1fr;
    }
    .article-card {
      padding: 28px 0;
    }
    #about {
      padding: 40px 24px;
    }

    #about h2 {
      margin-bottom: 40px;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    #hero {
      margin-top: 16px;
      margin-bottom: 72px;
      padding: 40px 24px;
    }

    #hero h1 {
      font-size: clamp(42px, 13vw, 64px);
    }

    .hero-description {
      font-size: 18px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
